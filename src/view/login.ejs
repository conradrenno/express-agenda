<%- include('includes/head') %>
    <%- include('includes/nav') %>
        <div class="container">
            <div class="row">
                <div class="col-lg-2"></div>
                <div class="col-lg-8 my-3">
                    <h1 class="text-center">Criar conta ou entrar</h1>
                    <p class="lead text-center">Faça seu login ou crie sua conta abaixo</p>

                    <%- include('includes/messages') %>


                        <div class="row">
                            <div class="col-lg">
                                <h4>Faça seu cadastro</h4>
                                <p>Se você ainda não tem uma conta, preecha o formulário abaixo:</p>

                                <form action="/login/register" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <div class="mb-3">
                                        <label for="exampleInputEmail1" class="form-label">Seu e-mail</label>
                                        <input type="email" class="form-control" name="email">
                                    </div>
                            </div>
                            <div class="mb-3">
                                <label for="exampleInputPassword1" class="form-label">Sua senha</label>
                                <input type="password" class="form-control" name="password">
                            </div>
                            <button type="submit" class="btn btn-primary">Criar minha conta</button>
                            </form>
                        </div>
                        <div class="col-lg">
                            <h4>Faça seu login</h4>
                            <p>Se você já tem uma conta, faça seu login abaixo:</p>
                            <form action="/login/login" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="mb-3">
                                    <label for="exampleInputEmail1" class="form-label">Seu e-mail</label>
                                    <input type="email" class="form-control" name="email">
                                </div>
                                <div class="mb-3">
                                    <label for="exampleInputPassword1" class="form-label">Sua senha</label>
                                    <input type="password" class="form-control" name="password">
                                </div>
                                <button type="submit" class="btn btn-primary">Entrar</button>
                            </form>
                        </div>
                </div>
            </div>
            <div class="col-lg-2"></div>
        </div>
        </div>
        <%- include('includes/footer') %>